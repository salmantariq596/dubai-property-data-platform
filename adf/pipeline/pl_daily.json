{
  "name": "pl_daily",
  "properties": {
    "description": "Daily load: land today's files, then run the Databricks job. load_date defaults to today (Dubai time).",
    "parameters": {
      "load_date": {
        "type": "String",
        "defaultValue": ""
      },
      "datasets": {
        "type": "String",
        "defaultValue": "transactions,rents"
      },
      "source_urls": {
        "type": "String",
        "defaultValue": "{}"
      },
      "catalog": {
        "type": "String",
        "defaultValue": "dubai"
      },
      "databricks_host": {
        "type": "String",
        "defaultValue": ""
      },
      "databricks_job_id": {
        "type": "String",
        "defaultValue": ""
      },
      "alert_webhook_url": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "Set load date",
        "type": "SetVariable",
        "dependsOn": [],
        "typeProperties": {
          "variableName": "day",
          "value": {
            "value": "@if(empty(pipeline().parameters.load_date), formatDateTime(convertFromUtc(utcNow(), 'Arabian Standard Time'), 'yyyy-MM-dd'), pipeline().parameters.load_date)",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Land files",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Set load date",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_land_day",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "load_date": {
              "value": "@variables('day')",
              "type": "Expression"
            },
            "datasets": {
              "value": "@pipeline().parameters.datasets",
              "type": "Expression"
            },
            "source_urls": {
              "value": "@pipeline().parameters.source_urls",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Alert landing failed",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Land files",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_alert",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "message": {
              "value": "@concat('Landing source files failed: ', variables('day'))",
              "type": "Expression"
            },
            "alert_webhook_url": {
              "value": "@pipeline().parameters.alert_webhook_url",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Run Databricks job",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Land files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_run_job",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "load_id": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            },
            "datasets": {
              "value": "@pipeline().parameters.datasets",
              "type": "Expression"
            },
            "catalog": {
              "value": "@pipeline().parameters.catalog",
              "type": "Expression"
            },
            "databricks_host": {
              "value": "@pipeline().parameters.databricks_host",
              "type": "Expression"
            },
            "databricks_job_id": {
              "value": "@pipeline().parameters.databricks_job_id",
              "type": "Expression"
            },
            "alert_webhook_url": {
              "value": "@pipeline().parameters.alert_webhook_url",
              "type": "Expression"
            }
          }
        }
      }
    ],
    "variables": {
      "day": {
        "type": "String",
        "defaultValue": ""
      }
    }
  }
}
