table fact_sales

	measure Sales = COUNTROWS ( fact_sales )
		formatString: #,0
		displayFolder: Sales

	measure 'Sales Value AED' = SUM ( fact_sales[value_aed] )
		formatString: #,0
		displayFolder: Sales

	measure 'Sales Value USD' = SUM ( fact_sales[value_usd] )
		formatString: #,0
		displayFolder: Sales

	measure 'Priced Sales' = CALCULATE ( COUNTROWS ( fact_sales ), fact_sales[is_outlier] = FALSE (), NOT ISBLANK ( fact_sales[price_per_sqft] ) )
		formatString: #,0
		displayFolder: Sales

	measure 'Median Price per Sqft' = CALCULATE ( MEDIAN ( fact_sales[price_per_sqft] ), fact_sales[is_outlier] = FALSE () )
		formatString: #,0
		displayFolder: Prices

	measure 'Median Sale Price AED' = CALCULATE ( MEDIAN ( fact_sales[value_aed] ), fact_sales[is_outlier] = FALSE () )
		formatString: #,0
		displayFolder: Prices

	measure 'Median Price per Sqft LY' = CALCULATE ( [Median Price per Sqft], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,0
		displayFolder: Prices

	measure 'Median Price per Sqft YoY %' =
			VAR Current = [Median Price per Sqft]
			VAR LastYear = [Median Price per Sqft LY]
			RETURN DIVIDE ( Current - LastYear, LastYear )
		formatString: 0.0%
		displayFolder: Prices

	measure 'Off-plan Sales' = CALCULATE ( [Sales], fact_sales[is_offplan] = TRUE () )
		formatString: #,0
		displayFolder: Off-plan

	measure 'Off-plan Share' = DIVIDE ( [Off-plan Sales], [Sales] )
		formatString: 0.0%
		displayFolder: Off-plan

	measure 'Median Price per Sqft Off-plan' = CALCULATE ( [Median Price per Sqft], fact_sales[is_offplan] = TRUE () )
		formatString: #,0
		displayFolder: Off-plan

	measure 'Median Price per Sqft Ready' = CALCULATE ( [Median Price per Sqft], fact_sales[is_offplan] = FALSE () )
		formatString: #,0
		displayFolder: Off-plan

	measure 'Off-plan Premium %' = DIVIDE ( [Median Price per Sqft Off-plan] - [Median Price per Sqft Ready], [Median Price per Sqft Ready] )
		formatString: 0.0%
		displayFolder: Off-plan

	column transaction_id
		dataType: string
		summarizeBy: none
		sourceColumn: transaction_id

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column area_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: area_sk

	column property_type_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: property_type_sk

	column project_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: project_sk

	column area_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: area_key

	column size_sqft
		dataType: decimal
		formatString: #,0
		summarizeBy: none
		sourceColumn: size_sqft

	column value_aed
		dataType: decimal
		formatString: #,0
		summarizeBy: none
		sourceColumn: value_aed

	column value_usd
		dataType: decimal
		formatString: #,0
		summarizeBy: none
		sourceColumn: value_usd

	column price_per_sqft
		dataType: decimal
		formatString: #,0
		summarizeBy: none
		sourceColumn: price_per_sqft

	column is_offplan
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_offplan

	column is_outlier
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_outlier

	column bedrooms
