		summarizeBy: none
		sourceColumn: property_usage_en

	column _load_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: _load_id

	partition fact_sales = m
		mode: import
		source = GoldTable("fact_sales")
