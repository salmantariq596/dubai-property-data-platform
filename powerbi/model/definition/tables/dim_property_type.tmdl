table dim_property_type

	column property_type_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: property_type_sk

	column property_type_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: property_type_key

	column property_type
		dataType: string
		summarizeBy: none
		sourceColumn: property_type

	column property_sub_type
		dataType: string
		summarizeBy: none
		sourceColumn: property_sub_type

	column in_sales
		dataType: boolean
		summarizeBy: none
		sourceColumn: in_sales

	column in_rents
		dataType: boolean
		summarizeBy: none
		sourceColumn: in_rents

	partition dim_property_type = m
		mode: import
		source = GoldTable("dim_property_type")
