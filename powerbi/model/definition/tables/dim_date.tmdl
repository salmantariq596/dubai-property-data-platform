table dim_date
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: quarter

	column month
		dataType: int64
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

	column month_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_key

	column month_start
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month_start

	column day_of_month
		dataType: int64
		summarizeBy: none
		sourceColumn: day_of_month

	column iso_weekday
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: iso_weekday

	column day_name
		dataType: string
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: iso_weekday

	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	partition dim_date = m
		mode: import
		source = GoldTable("dim_date")
