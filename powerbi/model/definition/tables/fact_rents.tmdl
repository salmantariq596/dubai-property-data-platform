table fact_rents

	measure Contracts = COUNTROWS ( fact_rents )
		formatString: #,0
		displayFolder: Rents

	measure 'Priced Contracts' = CALCULATE ( COUNTROWS ( fact_rents ), fact_rents[is_multi_unit] = FALSE (), NOT ISBLANK ( fact_rents[annual_rent_aed] ) )
		formatString: #,0
		displayFolder: Rents

	measure 'Median Annual Rent AED' = CALCULATE ( MEDIAN ( fact_rents[annual_rent_aed] ), fact_rents[is_multi_unit] = FALSE () )
		formatString: #,0
		displayFolder: Rents

	measure 'Gross Yield %' =
			VAR Rent = [Median Annual Rent AED]
			VAR Price = [Median Sale Price AED]
			VAR Enough = [Priced Sales] >= 10 && [Priced Contracts] >= 10
			RETURN IF ( Enough, DIVIDE ( Rent, Price ) )
		formatString: 0.00%
		displayFolder: Yield

	column contract_id
		dataType: string
		summarizeBy: none
		sourceColumn: contract_id

	column date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	column end_date_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: end_date_key

	column area_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: area_sk

	column property_type_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: property_type_sk

	column project_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: project_sk

	column area_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: area_key

	column annual_rent_aed
		dataType: decimal
		formatString: #,0
		summarizeBy: none
		sourceColumn: annual_rent_aed

	column size_sqft
		dataType: decimal
		formatString: #,0
		summarizeBy: none
		sourceColumn: size_sqft

	column contract_days
		dataType: int64
		summarizeBy: none
		sourceColumn: contract_days

	column is_multi_unit
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_multi_unit

	column contract_reg_type_en
		dataType: string
		summarizeBy: none
		sourceColumn: contract_reg_type_en

	column property_usage_en
		dataType: string
		summarizeBy: none
		sourceColumn: property_usage_en

	column _load_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: _load_id

	partition fact_rents = m
		mode: import
		source = GoldTable("fact_rents")
