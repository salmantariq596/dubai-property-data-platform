table agg_area_monthly

	column month_key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_key

	column month_start
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month_start

	column area_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: area_key

	column area_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: area_sk

	column area_name_en
		dataType: string
		summarizeBy: none
		sourceColumn: area_name_en

	column property_type_sk
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: property_type_sk

	column sales_count
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: sales_count

	column sales_value_aed
		dataType: decimal
		formatString: #,0
		summarizeBy: none
		sourceColumn: sales_value_aed

	column offplan_sales_count
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: offplan_sales_count

	column priced_sales_count
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: priced_sales_count

	column median_price_per_sqft
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: median_price_per_sqft

	column median_price_per_sqft_yoy_pct
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: median_price_per_sqft_yoy_pct

	column median_sale_price_aed
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: median_sale_price_aed

	column rent_count
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: rent_count

	column priced_rent_count
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: priced_rent_count

	column median_annual_rent_aed
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: median_annual_rent_aed

	column gross_yield_pct
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: gross_yield_pct

	partition agg_area_monthly = m
		mode: import
		source = GoldTable("agg_area_monthly")
