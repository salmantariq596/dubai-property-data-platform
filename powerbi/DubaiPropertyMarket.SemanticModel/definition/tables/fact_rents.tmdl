table fact_rents
	lineageTag: 5054e228-7ded-42dd-bce6-ba4579b4af6f

	measure Contracts = COUNTROWS ( fact_rents )
		formatString: #,0
		displayFolder: Rents
		lineageTag: 69524cff-ee36-4a7b-9df4-10cf6140ef04

	measure 'Priced Contracts' = CALCULATE ( COUNTROWS ( fact_rents ), fact_rents[is_multi_unit] = FALSE (), NOT ISBLANK ( fact_rents[annual_rent_aed] ), KEEPFILTERS ( fact_rents[property_usage_en] = "Residential" ), KEEPFILTERS ( dim_property_type[property_type] IN { "Unit", "Villa" } ) )
		formatString: #,0
		displayFolder: Rents
		lineageTag: 3b08eb5d-f030-4f93-829c-64ca40904318

	measure 'Median Annual Rent AED' = CALCULATE ( MEDIAN ( fact_rents[annual_rent_aed] ), fact_rents[is_multi_unit] = FALSE (), KEEPFILTERS ( fact_rents[property_usage_en] = "Residential" ), KEEPFILTERS ( dim_property_type[property_type] IN { "Unit", "Villa" } ) )
		formatString: #,0
		displayFolder: Rents
		lineageTag: 23e45abb-41f8-4a09-acbf-250c41557537

	measure 'Gross Yield %' =
			VAR Months = CALCULATETABLE ( VALUES ( dim_date[month_key] ), fact_rents )
			VAR Types = CALCULATETABLE ( VALUES ( dim_property_type[property_type] ), KEEPFILTERS ( dim_property_type[property_type] IN { "Unit", "Villa" } ) )
			VAR Cells = ADDCOLUMNS ( CROSSJOIN ( Months, Types ), "CellRent", [Median Annual Rent AED], "CellPrice", CALCULATE ( [Median Sale Price AED], fact_sales[is_offplan] = FALSE () ), "CellContracts", [Priced Contracts], "CellReadySales", CALCULATE ( [Priced Sales], fact_sales[is_offplan] = FALSE () ) )
			VAR Compared = FILTER ( Cells, [CellContracts] >= 10 && [CellReadySales] >= 10 && [CellPrice] > 0 )
			RETURN DIVIDE ( SUMX ( Compared, [CellRent] / [CellPrice] * [CellContracts] ), SUMX ( Compared, [CellContracts] ) )
		formatString: 0.00%
		displayFolder: Yield
		lineageTag: 58078a78-60bf-4b89-8add-d2da6a90f8f3

