	annotation PBI_ResultType = Text

expression GoldTable =
		(table_name as text) as table =>
		let
		    FromDatabricks = () =>
		        let
		            // Looked up only when GoldSource is Databricks: Power BI does not know the
		            // connector's name until it has been used, which would break the Parquet route too.
		            Connector = Record.FieldOrDefault(#shared, "Databricks.Catalogs", Record.FieldOrDefault(#shared, "DatabricksMultiCloud.Catalogs")),
		            Source = Connector(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
		            CatalogData = Source{[Name = GoldCatalog, Kind = "Database"]}[Data],
		            Gold = CatalogData{[Name = "gold", Kind = "Schema"]}[Data],
		            Result = Gold{[Name = table_name, Kind = "Table"]}[Data]
		        in
		            Result,
		    FromParquet = () =>
		        let
		            Files = Folder.Files(GoldFolder & "\" & table_name),
		            ParquetFiles = Table.SelectRows(Files, each [Extension] = ".parquet"),
		            // The export writes one file per table. Read only the newest, so a
		            // re-download next to an old file does not double the rows.
		            Newest = Table.FirstN(Table.Sort(ParquetFiles, {{"Date modified", Order.Descending}}), 1),
		            Result = Parquet.Document(Newest{0}[Content])
		        in
		            Result
		in
		    if GoldSource = "Parquet" then FromParquet() else FromDatabricks()
	lineageTag: 7efffc80-27c8-4369-9587-e66d8fb7a183

	annotation PBI_ResultType = Function

