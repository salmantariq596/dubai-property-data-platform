model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-PK
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dim_date","dim_area","dim_property_type","dim_project","fact_sales","fact_rents","agg_area_monthly","GoldSource","DatabricksHost","DatabricksHttpPath","GoldCatalog","GoldFolder","GoldTable"]

ref table dim_date
ref table dim_area
ref table dim_property_type
ref table dim_project
ref table fact_sales
ref table fact_rents
ref table agg_area_monthly

ref cultureInfo en-US

